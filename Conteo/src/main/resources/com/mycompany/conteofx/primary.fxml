<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="15.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.conteofx.PrimaryController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <Label text="Contar número de clics" />
    <TextField fx:id="txtConteo" editable="false" text="0" alignment="CENTER" />
    <Button fx:id="btnContar" text="¡Contar!" onAction="#handleContarAction" />

    <Label text="Esperar 10 segundos" />
    <ProgressBar fx:id="progressBar" prefWidth="300.0" progress="0.0" />
    <Button fx:id="btnEsperar" text="¡Esperar!" onAction="#handleEsperarAction" />
</VBox>