<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<HBox spacing="40.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.minenana.gastos.PrimaryController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <VBox spacing="10.0">
        <HBox spacing="10.0">
            <Label text="Alimentación" minWidth="100.0" />
            <TextField fx:id="txtAlimentacion" prefWidth="80.0" />
        </HBox>
        <HBox spacing="10.0">
            <Label text="Refrigerios" minWidth="100.0" />
            <TextField fx:id="txtRefrigerios" prefWidth="80.0" />
        </HBox>
        <HBox spacing="10.0">
            <Label text="Transporte" minWidth="100.0" />
            <TextField fx:id="txtTransporte" prefWidth="80.0" />
        </HBox>
        <HBox spacing="10.0">
            <Label text="Teléfono" minWidth="100.0" />
            <TextField fx:id="txtTelefono" prefWidth="80.0" />
        </HBox>
        <HBox spacing="10.0">
            <Label text="Otros" minWidth="100.0" />
            <TextField fx:id="txtOtros" prefWidth="80.0" />
        </HBox>

        <HBox spacing="10.0">
            <Button onAction="#handleCalcular" text="Calcular estadísticas" />
            <Button onAction="#handleLimpiar" text="Limpiar" />
        </HBox>
    </VBox>

    <VBox spacing="10.0">
        <Label text="Estadísticas" />
        <Label text="Total semanal" />
        <TextField fx:id="txtTotal" editable="false" prefWidth="120.0" />
        <Label text="Gasto más alto" />
        <TextField fx:id="txtGastoMasAlto" editable="false" prefWidth="120.0" />
    </VBox>
</HBox>