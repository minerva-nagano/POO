<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.geometry.Insets?>

<VBox alignment="CENTER" spacing="20.0"
      style="-fx-background-color: #f4f6f8; -fx-font-family: 'Segoe UI'; -fx-font-size: 14px;"
      xmlns="http://javafx.com/javafx/8.0.171"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.minenana.edad.PrimaryController">
   <children>

      <HBox alignment="CENTER" spacing="10.0">
         <children>
            <Label text="Fecha de nacimiento"
                   style="-fx-text-fill: #333333; -fx-font-weight: bold;" />
            <DatePicker fx:id="dateNacimiento"
                        style="-fx-background-radius: 6;" />
         </children>
      </HBox>

      <HBox alignment="CENTER" spacing="10.0">
         <children>
            <Button fx:id="CalcularButton" text="Calcular" onAction="#CalcularFecha"
                    style="-fx-background-color: #4a90e2;
                           -fx-text-fill: white;
                           -fx-font-weight: bold;
                           -fx-background-radius: 8;
                           -fx-padding: 8 18 8 18;
                           -fx-cursor: hand;" />
            <Button fx:id="LimpiarButton" text="Limpiar" onAction="#LimpiarFecha"
                    style="-fx-background-color: #b0b7c0;
                           -fx-text-fill: white;
                           -fx-font-weight: bold;
                           -fx-background-radius: 8;
                           -fx-padding: 8 18 8 18;
                           -fx-cursor: hand;" />
         </children>
      </HBox>

      <Label fx:id="lbResultado" text=""
             style="-fx-text-fill: #1b6e3c;
                    -fx-font-size: 16px;
                    -fx-font-weight: bold;
                    -fx-padding: 10 0 0 0;" />

   </children>
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
</VBox>