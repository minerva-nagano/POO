<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="15.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.minenana.ejercicio1_3.PrimaryController">
   <padding>
      <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
   </padding>
   
   <HBox alignment="CENTER_LEFT" spacing="10.0">
      <Label text="Ingrese un número:" />
      <TextField fx:id="txtNumero" prefWidth="100.0" />
      <Button onAction="#handleAnalizar" text="Analizar" />
      <Button onAction="#handleLimpiar" text="Limpiar" />
   </HBox>

   <HBox spacing="40.0">
      <VBox spacing="10.0">
         <HBox spacing="10.0">
            <Label text="Cantidad de cifras:" minWidth="150.0" />
            <TextField fx:id="txtCantidad" editable="false" prefWidth="80.0" />
         </HBox>
         <HBox spacing="10.0">
            <Label text="Suma de cifras impares:" minWidth="150.0" />
            <TextField fx:id="txtSumaImpares" editable="false" prefWidth="80.0" />
         </HBox>
         <HBox spacing="10.0">
            <Label text="Suma de cifras pares:" minWidth="150.0" />
            <TextField fx:id="txtSumaPares" editable="false" prefWidth="80.0" />
         </HBox>
         <HBox spacing="10.0">
            <Label text="Suma total de cifras:" minWidth="150.0" />
            <TextField fx:id="txtSumaTotal" editable="false" prefWidth="80.0" />
         </HBox>
         <HBox spacing="10.0">
            <Label text="Cifra mayor:" minWidth="150.0" />
            <TextField fx:id="txtMayor" editable="false" prefWidth="80.0" />
         </HBox>
         <HBox spacing="10.0">
            <Label text="Cifra menor:" minWidth="150.0" />
            <TextField fx:id="txtMenor" editable="false" prefWidth="80.0" />
         </HBox>
      </VBox>

      <VBox spacing="5.0">
         <Label text="Divisores" />
         <ListView fx:id="listDivisores" prefHeight="200.0" prefWidth="120.0" />
      </VBox>
   </HBox>
</VBox>