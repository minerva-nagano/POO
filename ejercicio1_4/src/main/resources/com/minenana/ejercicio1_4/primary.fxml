<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="15.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.minenana.ejercicio1_4.PrimaryController">
   <padding>
      <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
   </padding>
   
   <HBox spacing="20.0" alignment="CENTER_LEFT">
      <Label text="Tabla del:" />
      <TextField fx:id="txtNumero" prefWidth="60.0" />
      
      <VBox spacing="10.0">
         <Button onAction="#handleCalcular" text="Calcular" prefWidth="100.0" />
         <Button onAction="#handleLimpiar" text="Limpiar" prefWidth="100.0" />
      </VBox>
   </HBox>

   <TextArea fx:id="txtResultado" editable="false" prefHeight="250.0" prefWidth="300.0" />
</VBox>